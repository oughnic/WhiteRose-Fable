  "description": "ContSys Hospital — a first-person 3D exploration of the ContSys concept model, styled as a 1960s NHS hospital",
  "type": "module",
  "scripts": {
    "world": "node tools/build-world.mjs",
    "audit": "node tools/audit-world.mjs",
